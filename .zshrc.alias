# Tmux
function tmuxall() {
    for file in ~/.config/tmuxinator/*.yaml; do tmuxinator start "$(basename "$file" .yaml)" --no-attach; done
}

# DBML
function dbml() {
  local tables=()
  local outdir="."
  local output="output"

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case $1 in
      -o|--output) output=$2; shift 2 ;;
      -d|--dir)    outdir=$2; shift 2 ;;
      *) tables+=($1); shift ;;
    esac
  done

  if [[ ${#tables[@]} -eq 0 ]]; then
    echo "Usage: dbml <table1> [table2] ... [-o output_name] [-d output_dir]"
    return 1
  fi

  if [[ -z "$DB_CONNECTION" ]]; then
    echo "❌ \$DB_CONNECTION is not set"
    return 1
  fi

  rm -f "${outdir}/${output}.dbml"

  local tmp=$(mktemp /tmp/dbml_dump_XXXX.sql)

  for table in "${tables[@]}"; do
    echo "🔍 Fetching schema for: $table..."
    pg_dump "$DB_CONNECTION" \
      --schema-only \
      --no-owner \
      --no-privileges \
      --table "$table" >> "$tmp"
  done

  sql2dbml --postgres "$tmp" -o "${outdir}/${output}.dbml"
  rm "$tmp"

  echo "✅ Created: ${outdir}/${output}.dbml"
}

# Claude 
function reset_claude() {
  rm ~/.claude.json
  rm -rf ~/.claude
}
alias clauded="claude --dangerously-skip-permissions"

# Codex 
alias codexed="codex --dangerously-bypass-approvals-and-sandbox"

# Ollama
alias qwen="ollama launch claude --model qwen3.6:27b"

# Homebrew
function bup() {
  echo "🍺 Updating Homebrew..."
  brew update && brew upgrade && brew cleanup
}
