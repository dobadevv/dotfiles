# Neovim
alias n="nvim"
alias nvim_clear_cache="rm ~/.local/share/nvim/sessions/*"
alias nvim_reset="rm -rf ~/.local/share/nvim && rm -rf ~/.local/state/nvim && rm -rf ~/.cache/nvim"

# Load environment from a dotfile
function load() {
    set -a
    source $1
    set +a
}

# JQ
function j2q() {
  echo "$1" | jq -r 'to_entries | map("\(.key)=\(.value|@uri)") | join("&")'
}

function q2j() {
  echo "$1" | awk -F '[=&]' '{
       printf "{";
       for (i=1; i<=NF; i+=2) {
         if (i>1) printf ",";
         printf "\"%s\":\"%s\"", $i, $(i+1);
       }
       printf "}\n";
     }' | sed 's/+/ /g' | jq .
}

# Yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Nodejs
alias pn='pnpm'
alias psd='pnpm start:dev'

function now() {
    local day="" month="" year="" hour="" minute=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            -d) day="$2"; shift 2 ;;
            -m) month="$2"; shift 2 ;;
            -y) year="$2"; shift 2 ;;
            -h) hour="$2"; shift 2 ;;
            -mi) minute="$2"; shift 2 ;;
            *)
                echo "Usage: now [-d day] [-m month] [-y year] [-h hour] [-mi minute]" >&2
                return 1
                ;;
        esac
    done

    if [[ -z "$day" && -z "$month" && -z "$year" && -z "$hour" && -z "$minute" ]]; then
        node -e "console.log(new Date().toISOString())"
        return
    fi

    NOW_DAY="$day" NOW_MONTH="$month" NOW_YEAR="$year" NOW_HOUR="$hour" NOW_MINUTE="$minute" node -e '
    const VN_OFFSET_MS = 7 * 60 * 60 * 1000;
    const nowVN = new Date(Date.now() + VN_OFFSET_MS);
    const year = process.env.NOW_YEAR ? parseInt(process.env.NOW_YEAR, 10) : nowVN.getUTCFullYear();
    const month = process.env.NOW_MONTH ? parseInt(process.env.NOW_MONTH, 10) - 1 : nowVN.getUTCMonth();
    const day = process.env.NOW_DAY ? parseInt(process.env.NOW_DAY, 10) : nowVN.getUTCDate();
    const hour = process.env.NOW_HOUR ? parseInt(process.env.NOW_HOUR, 10) : 0;
    const minute = process.env.NOW_MINUTE ? parseInt(process.env.NOW_MINUTE, 10) : 0;
    const utcMs = Date.UTC(year, month, day, hour, minute) - VN_OFFSET_MS;
    console.log(new Date(utcMs).toISOString());
    '
}

# Docker
alias dp='docker ps'
alias di='docker images'
alias dr='docker rm'
alias dri='docker rmi'
alias lzd='lazydocker'
alias dcu='docker compose up -d --build && drni'
alias dcd='docker compose down'

function drni() {
    docker images --filter "dangling=true" -q --no-trunc | xargs -r docker rmi
}

# Git
alias lg='lazygit'
alias g='git'
