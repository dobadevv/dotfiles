alias gb='git branch'
alias gs='git status'
alias cz='cz --name cz_ai commit'

# Bump the patch version and create a new git tag
# Usage: bump-patch [suffix]
#   bump_patch          -> v1.0.15 -> v1.0.16
#   bump_patch rc        -> v1.0.15 -> v1.0.16-rc
function bump_patch() {
  local suffix="$1"
  local latest_tag
  latest_tag=$(git tag -l "v*.*.*-rc" --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+' | head -n1)

  if [[ -z "$latest_tag" ]]; then
    echo "No existing tags found matching vX.Y.Z" >&2
    return 1
  fi

  # Strip any suffix (e.g. -rc, -rc1) to get the bare version
  local base_version="${latest_tag%%-*}"
  local major minor patch
  major=$(echo "$base_version" | cut -d. -f1 | tr -d 'v')
  minor=$(echo "$base_version" | cut -d. -f2)
  patch=$(echo "$base_version" | cut -d. -f3)

  local new_patch=$((patch + 1))
  local new_tag="v${major}.${minor}.${new_patch}-rc"

  if [[ -n "$suffix" ]]; then
    new_tag="${new_tag}-${suffix}"
  fi

  echo "Latest tag: $latest_tag"
  echo "New tag:    $new_tag"

  read -q "REPLY?Create and push this tag? (y/n) "
  echo
  if [[ "$REPLY" == "y" ]]; then
    git tag "$new_tag"
    git push origin "$new_tag"
    echo "Tagged and pushed: $new_tag"
  else
    echo "Aborted."
  fi
}

# Kubernetes
alias kube='kubectl'

# Tmux
alias work='tmuxall && tmux attach -t dotfiles'

function tmuxall() {
    for file in ~/.config/tmuxinator/*.yaml; do tmuxinator start "$(basename "$file" .yaml)" --no-attach; done
}

# DBML
function dbml() {
  local tables=()
  local outdir="."
  local output="output"

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case $1 in
      -o|--output) output=$2; shift 2 ;;
      -d|--dir)    outdir=$2; shift 2 ;;
      *) tables+=($1); shift ;;
    esac
  done

  if [[ ${#tables[@]} -eq 0 ]]; then
    echo "Usage: dbml <table1> [table2] ... [-o output_name] [-d output_dir]"
    return 1
  fi

  if [[ -z "$DB_CONNECTION" ]]; then
    echo "❌ \$DB_CONNECTION is not set"
    return 1
  fi

  rm -f "${outdir}/${output}.dbml"

  local tmp=$(mktemp /tmp/dbml_dump_XXXX.sql)

  for table in "${tables[@]}"; do
    echo "🔍 Fetching schema for: $table..."
    pg_dump "$DB_CONNECTION" \
      --schema-only \
      --no-owner \
      --no-privileges \
      --table "$table" >> "$tmp"
  done

  sql2dbml --postgres "$tmp" -o "${outdir}/${output}.dbml"
  rm "$tmp"

  echo "✅ Created: ${outdir}/${output}.dbml"
}

# Claude 
function reset_claude() {
  rm ~/.claude.json
  rm -rf ~/.claude
}
alias clauded="claude --dangerously-skip-permissions"

# Codex 
alias codexed="codex --dangerously-bypass-approvals-and-sandbox"

# Ollama
alias qwen="ollama launch claude --model qwen3.6:27b"

# Homebrew
alias brew_dump="rm -f ~/dotfiles/Brewfile && brew bundle dump --file=~/dotfiles/Brewfile"
alias brew_restore="brew bundle --file=~/dotfiles/Brewfile"

function bup() {
  echo "🍺 Updating Homebrew..."
  brew update && brew upgrade && brew cleanup
}
